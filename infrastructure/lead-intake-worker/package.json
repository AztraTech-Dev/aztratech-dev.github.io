{
  "name": "aztratech-lead-intake-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker: lead intake backend for aztra.tech (POST /lead, D1 storage).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply aztratech-leads --local",
    "migrate:remote": "wrangler d1 migrations apply aztratech-leads --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "wrangler": "4.136.3"
  }
}
